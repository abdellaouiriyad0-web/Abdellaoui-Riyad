{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "nameLower": { "type": "string", "description": "Lowercase name for case-insensitive search" },
        "searchKeywords": { "type": "array", "items": { "type": "string" }, "description": "Prefixes for partial matching" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["farmer", "veterinarian", "engineer", "supplier"] },
        "bio": { "type": "string" },
        "specialization": { "type": "string" },
        "wilaya": { "type": "string" },
        "commune": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Request": {
      "title": "Service Request",
      "description": "A formal service request between a farmer and an expert/supplier",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "requesterId": { "type": "string" },
        "providerId": { "type": "string" },
        "serviceType": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "cancelled"] },
        "date": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["requesterId", "providerId", "status"]
    },
    "Message": {
      "title": "Chat Message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "voice", "image"] },
        "mediaUrl": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["senderId", "type", "timestamp"]
    },
    "Community": {
      "title": "Professional Community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["crop", "livestock", "topic"] },
        "creatorId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "CommunityPost": {
      "title": "Knowledge Sharing Post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      }
    },
    "Follow": {
      "title": "Professional Follow",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "followedAt": { "type": "string" }
      }
    },
    "Call": {
      "title": "Communication Event",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["calling", "ongoing", "ended", "missed"] },
        "type": { "type": "string", "enum": ["audio", "video"] },
        "createdAt": { "type": "string" }
      }
    },
    "Memory": {
      "title": "User Memory",
      "type": "object",
      "properties": {
        "recentSearches": { "type": "array", "items": { "type": "string" } },
        "visitedProfiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PersonalPost": {
      "title": "Personal Profile Post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "likesCount": { "type": "number" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "PostComment": {
      "title": "Profile Post Comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "PostLike": {
      "title": "Profile Post Like",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "Product": {
      "title": "Marketplace Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "sellerId", "createdAt"]
    },
    "Order": {
      "title": "Marketplace Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "shippingAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "items", "totalAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Global user profiles" },
    "/users/{userId}/memory/history": { "schema": "Memory", "description": "Lightweight user history" },
    "/users/{userId}/following/{followedId}": { "schema": "Follow", "description": "Users followed by this user" },
    "/users/{userId}/followers/{followerId}": { "schema": "Follow", "description": "Users following this user" },
    "/users/{userId}/posts/{postId}": { "schema": "PersonalPost", "description": "Individual user posts" },
    "/users/{userId}/posts/{postId}/likes/{likeId}": { "schema": "PostLike", "description": "Likes on personal posts" },
    "/users/{userId}/posts/{postId}/comments/{commentId}": { "schema": "PostComment", "description": "Comments on personal posts" },
    "/requests/{requestId}": { "schema": "Request", "description": "Service tracking" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Messaging system" },
    "/communities/{communityId}": { "schema": "Community", "description": "Professional groups" },
    "/communities/{communityId}/members/{userId}": { "schema": "User", "description": "Community members" },
    "/communities/{communityId}/posts/{postId}": { "schema": "CommunityPost", "description": "Knowledge sharing" },
    "/calls/{callId}": { "schema": "Call", "description": "Real-time communication" },
    "/products/{productId}": { "schema": "Product", "description": "Marketplace items" },
    "/orders/{orderId}": { "schema": "Order", "description": "Purchase records" }
  }
}
