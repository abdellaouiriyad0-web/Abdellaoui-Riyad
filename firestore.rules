rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Phase 0: Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'abdellaouiriyad0@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && (
          incoming().uid == existing().uid &&
          (
            (incoming().role == existing().role && incoming().isVerified == existing().isVerified) ||
            isAdmin() ||
            (!('role' in existing()) || !('isVerified' in existing()))
          )
        )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount', 'professionalStatus']))
      );
      
      match /memory/history {
        allow read, write: if isOwner(userId);
      }

      match /following/{followedId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(followerId) || isOwner(userId);
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && (incoming().authorId == request.auth.uid || isAdmin());
        allow update, delete: if isOwner(userId) || isAdmin();

        match /likes/{likeId} {
          allow read: if isSignedIn();
          allow create, delete: if isSignedIn() && likeId == request.auth.uid;
        }

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
          allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isOwner(userId) || isAdmin());
        }
      }
    }

    // --- Communities ---
    match /communities/{communityId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.creatorId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['memberCount'])
      );

      match /members/{userId} {
        allow get, list: if isSignedIn();
        allow write: if isOwner(userId);
      }
      
      match /posts/{postId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && (incoming().authorId == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && (
          isAdmin() || 
          resource.data.authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
        );
        allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
        
        match /likes/{userId} {
          allow get, list: if isSignedIn();
          allow write: if isOwner(userId);
        }
        match /comments/{commentId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
          allow delete: if isAdmin() || (isSignedIn() && (resource.data.authorId == request.auth.uid || isOwner(userId)));
        }
      }
    }

    // --- Bookings ---
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.expertId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.expertId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (resource.data.userId == request.auth.uid && 
         incoming().status == 'cancelled' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }

    // --- Chats ---
    match /chats/{chatId} {
      function isChatMember() {
        return chatId.split('_')[0] == request.auth.uid || 
               chatId.split('_')[1] == request.auth.uid;
      }
      
      allow read, write: if isSignedIn() && (isAdmin() || isChatMember());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (isAdmin() || isChatMember());
        allow create: if isSignedIn() && isChatMember() && incoming().senderId == request.auth.uid;
      }
    }

    // --- Professional Applications ---
    match /professionalApplications/{appId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // --- Calls ---
    match /calls/{callId} {
      allow read: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().callerId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }

    // --- System / Internal ---
    match /test/connection {
      allow read: if true;
    }
  }
}
